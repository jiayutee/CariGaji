# Copy this file to .env and fill in your values. Never commit .env.

# Telegram bot credentials (from @BotFather and your chat ID)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Supabase (public anon key is safe to commit; service role key is NOT)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# GitHub PAT (fine-grained, read-only Actions/Contents) so the orchestrator
# can poll live deploy/run status via `gh`. Used as GH_TOKEN. Never commit.
GITHUB_TOKEN=github_pat_xxx

# Google Maps JS API key (Places library) for location autocomplete on the
# post-shift form. Restrict it to your domains in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Notion workspace pointers used by the orchestrator runbooks in
# .claude/scheduled-tasks/. Find each id in the URL of the page or database:
# https://app.notion.com/p/<PAGE_ID>. A data source id appears as
# collection://<DS_ID> in the output of the Notion fetch tool for that database.
NOTION_DAILY_LOG_PAGE=
NOTION_DAILY_LOG_DS=
NOTION_BACKLOG_PAGE=
NOTION_BACKLOG_DS=
NOTION_ROADMAP_PAGE=
NOTION_PARENT_PAGE=
